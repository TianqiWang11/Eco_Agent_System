# Copy to .env and fill only the credentials needed for this deployment.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_CHAT_MODEL=kimi-k3
MOONSHOT_REASONING_EFFORT=low
MOONSHOT_MAX_COMPLETION_TOKENS=2048
MOONSHOT_TIMEOUT=120
MOONSHOT_MAX_RETRIES=1

# This runtime intentionally supports only the official Kimi endpoint.

# PostgreSQL business data source. URL-encode reserved characters in the password.
DATA_SOURCE_MODE=database
DATABASE_URL=postgresql://chebaling:change-me@127.0.0.1:5432/chebaling
# Local Pixel Streaming signalling/player endpoint used by the portal iframe.
PIXEL_STREAMING_HTTP_PORT=8080
PIXEL_STREAMING_PLAYER_PATH=/uiless.html
PIXEL_STREAMING_AUTO_CONNECT=true
# Optional override; default is the repository-level data directory.
# CHEBALING_DATA_ROOT=D:/TQ_Projects/Chebaling_DigitalTwin_AI/data
# AGENT_STATE_DIR=D:/your-project/storage/agent
# Optional override. Without it, config/mcp.json is loaded automatically.
# AGENT_MCP_CONFIG=D:/your-project/config/mcp.json
# Optional production credential for a server configured with token_env.
# EXA_API_KEY=
AGENT_DOCKER_ENABLED=false
AGENT_DOCKER_IMAGE=python:3.11-slim
# OTLP HTTP collector base URL; empty disables export, not durable UI events.
AGENT_OTLP_ENDPOINT=
